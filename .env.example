# Telegram BotFather token
BOT_TOKEN=

# Google AI Studio / Gemini API key
GEMINI_API_KEY=

# Telegram numeric user IDs, comma-separated
ADMIN_IDS=123456789

# Nano Banana Pro stable model
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=2K
GEMINI_IMAGE_ASPECT_RATIO=9:16

# Reference and final Telegram image settings
# Optional override; bundled reference is used when this is blank.
REFERENCE_IMAGE_PATH=
OUTPUT_IMAGE_WIDTH=705
OUTPUT_IMAGE_HEIGHT=1280

# Runtime limits
GENERATION_TIMEOUT_SECONDS=240
GENERATION_MAX_ATTEMPTS=2
MAX_CONCURRENT_GENERATIONS=2
LOG_LEVEL=INFO
